{
  "name": "container_spring_boot_build_image_run_by_pipeline",
  "category": "positive",
  "description": "A pipeline job that runs bootBuildImage builds the image in CI even with no bootBuildImage block.",
  "setup": {},
  "facts": [
    {
      "id": "stack.container",
      "rule": "jib-detection",
      "path": "image_build",
      "value": true
    },
    {
      "id": "stack.container",
      "rule": "spring-boot-image-detection",
      "path": "spring_boot.run_by",
      "value": "the pipeline"
    },
    {
      "id": "stack.container",
      "rule": "spring-boot-image-detection",
      "path": "spring_boot.image_name",
      "value": "acme/app"
    }
  ],
  "criteria": []
}
